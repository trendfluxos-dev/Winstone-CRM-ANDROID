# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WINSTONE CRM & SUPABASE INTEGRATION PLACEHOLDERS (PHASE 2)
# Configurable by environment: Development, Staging, Production
VITE_CRM_ENV="development" # "development" | "staging" | "production"
VITE_CRM_BASE_URL="" # e.g. "https://crm-api.winstoneproperties.com/api/v1"
VITE_SUPABASE_URL="" # e.g. "https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="" # Client-safe anon/public key ONLY. Never service-role.
VITE_ENABLE_MOCK_FALLBACK="true" # Set to false in production builds
